EXPO_PUBLIC_SUPABASE_URL=your-project-url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# ML microservice URL — no secret needed in the client.
# Auth is handled via the user's Supabase JWT.
EXPO_PUBLIC_ML_URL=https://your-ml-service.railway.app
